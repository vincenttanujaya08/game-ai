{
  "name": "ai-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:lint": "node --conditions=react-server --import tsx scripts/lint-scenarios.ts",
    "content:compile": "node --conditions=react-server --import tsx scripts/compile-scenarios.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:lint"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  }
}
